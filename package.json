{
  "name": "pw-claude-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install --with-deps chromium && npx playwright init-agents --loop=claude",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "agent": "node agent/run-agent.js",
    "agent:heal": "node agent/run-agent.js --heal"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest"
  }
}
